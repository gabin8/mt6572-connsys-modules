	os/linux/gl_init.o \
	os/linux/gl_kal.o \
	os/linux/gl_bow.o \
	os/linux/gl_wext.o \
	os/linux/gl_wext_priv.o \
	os/linux/gl_rst.o \
	os/linux/gl_cfg80211.o \
	os/linux/gl_vendor.o \
	os/linux/platform.o \
	os/linux/gl_proc.o \
	mgmt/ais_fsm.o \
