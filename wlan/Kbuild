# MT6572 CONSYS Wi-Fi (gen2, AHB HIF) — wlan_gen2.ko
#
# Imported from the BPI-Router-Linux 4.14 gen2 tree. The ALPS MT65x2 3.4
# tree is the SoC-behaviour reference when the two disagree.
#
# Bring-up configuration:
#  - P2P/AP compiled out (CFG_ENABLE_WIFI_DIRECT=0, see include/config.h)
#  - PIO mode only: CONF_MTK_AHB_DMA=0 in os/linux/hif/ahb/include/hif.h;
#    the MT6572 DMA glue (AP_DMA GDMA2) is a later optimization

ccflags-y += -DLINUX -DMT6628
ccflags-y += -D_HIF_SDIO=1
ccflags-y += -DDBG=0

ccflags-y += -DCFG_ENABLE_WIFI_DIRECT=0
ccflags-y += -DCFG_SUPPORT_AGPS_ASSIST=0
ccflags-y += -DCFG_SUPPORT_TSF_USING_BOOTTIME=1
ccflags-y += -DCFG_P2P_LEGACY_COEX_REVISE=1
ccflags-y += -DARP_MONITER_ENABLE=1
ccflags-y += -DCFG_SUPPORT_WAPI=0
ccflags-y += -DCFG_SUPPORT_MCC=0
ccflags-y += -DCFG_SUPPORT_XLOG=0
ccflags-y += -DCFG_SUPPORT_AEE=0
ccflags-y += -DCFG_SUPPORT_HOTSPOT_2_0=0
ccflags-y += -DCFG_HS20_DEBUG=0
ccflags-y += -DCFG_ENABLE_GTK_FRAME_FILTER=0
ccflags-y += -DCFG_SUPPORT_MET_PROFILING=0
ccflags-y += -DCFG_TC1_FEATURE=0
ccflags-y += -DCFG_SRAM_SIZE_OPTION=0

ccflags-y += -I$(src)/os -I$(src)/os/linux/include -I$(src)/os/linux/hif/ahb/include
ccflags-y += -I$(src)/include -I$(src)/include/nic -I$(src)/include/mgmt
ccflags-y += -I$(src)/../compat_inc

obj-m += wlan_gen2.o

wlan_gen2-objs := \
	common/dump.o \
	common/wlan_lib.o \
	common/wlan_oid.o \
	common/wlan_bow.o \
	common/debug.o \
